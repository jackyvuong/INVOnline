# Supabase PostgreSQL (backend only)
ConnectionStrings__Default=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# JWT (backend only — min 32 chars)
Jwt__Secret=change-me-to-a-long-random-secret-min-32-chars
Jwt__Issuer=inventory-online
Jwt__Audience=inventory-online
Jwt__ExpiryMinutes=480

# Google OAuth — same Client ID on BE (validate token) and FE (Sign-In button)
Google__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# CORS
Cors__Origins=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com